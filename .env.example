# ==============================================================================
# SHADOW VOICE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your provider keys as needed.
# ==============================================================================

# Server & AudioSocket Ports
PORT=9000
AUDIOSOCKET_HOST=0.0.0.0
AUDIOSOCKET_PORT=9092

# Active LLM Provider (ollama | custom | groq | openrouter | openai | gemini | anthropic)
ACTIVE_LLM_PROVIDER=ollama

# Local / Self-Hosted LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
CUSTOM_LLM_BASE_URL=http://localhost:1234/v1
CUSTOM_LLM_MODEL=local-model
CUSTOM_LLM_API_KEY=

# Cloud LLM Provider Keys & Default Models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Speech-to-Text (STT) & Text-to-Speech (TTS)
STT_PROVIDER=deepgram_nova3
DEEPGRAM_API_KEY=

TTS_PROVIDER=cartesia_sonic
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Spend Guardrail & Compliance
DAILY_SPEND_CEILING_USD=50.00
